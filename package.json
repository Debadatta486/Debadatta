{
  "name": "debadatta-portfolio-browser-tests",
  "private": true,
  "version": "1.0.0",
  "description": "Automated browser regression checks for Debadatta Dutta's nine-panel portfolio",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:desktop": "playwright test --project=desktop-chromium",
    "test:mobile": "playwright test --project=mobile-chromium",
    "test:report": "playwright show-report",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
